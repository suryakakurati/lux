{
  "name": "lux",
  "productName": "Lux",
  "version": "0.2.2",
  "description": "Lux — a fully local, voice-first assistant for macOS.",
  "main": "./out/main/index.js",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "preview:renderer": "vite --config scripts/preview/vite.config.ts",
    "build": "electron-vite build",
    "start": "npm run build && electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm test && npm run evals",
    "test": "node --test \"tests/**/*.test.ts\"",
    "hotkey": "bash scripts/build-hotkey.sh",
    "stt:setup": "bash scripts/setup-stt.sh",
    "voice:setup": "bash scripts/setup-voice.sh",
    "smoke": "npm run build && electron out/main/smoke.js",
    "audit": "npm run build && electron out/main/audit.js",
    "bench": "npm run build && electron out/main/bench.js",
    "bench:baseline": "npm run build && LUX_BENCH_BASELINE=1 LUX_BENCH_RUNS=3 electron out/main/bench.js",
    "bench:rss": "npm run build && node scripts/measure-idle.mjs",
    "evals": "rolldown evals/run.ts -f cjs -p node -o .evals/run.cjs && node .evals/run.cjs",
    "assets": "python3 scripts/make-tray-icon.py",
    "package": "bash scripts/package.sh"
  },
  "dependencies": {
    "dompurify": "^3.4.18",
    "marked": "^18.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
