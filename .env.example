# Lux runs fully local without any of these.
# Copy to .env only if you need the optional Spotify Web API fallback.
# Playback by name uses Spotify's public search page and needs no credentials.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Development and diagnostics only. Never required for normal use.
LUX_DEBUG=
LUX_DATA_DIR=
LUX_SHOT=
LUX_SHOT_HUD=
LUX_BRIEF_NOW=
LUX_SMOKE_TOOL=
LUX_SMOKE_ARGS=
LUX_AUDIT_AUDIO=
